{
  "name": "animal-welfare-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "build": "node scripts/write-env.cjs && ionic build --prod",
    "test": "npx tsx --test tests/unit/domain.test.ts && pytest tests/unit tests/acceptance -q",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:all": "python3 tests/run_suite.py"
  },
  "dependencies": {
    "@angular/animations": "^19.2.4",
    "@angular/common": "^19.2.4",
    "@angular/compiler": "^19.2.4",
    "@angular/core": "^19.2.4",
    "@angular/forms": "^19.2.4",
    "@angular/platform-browser": "^19.2.4",
    "@angular/platform-browser-dynamic": "^19.2.4",
    "@angular/router": "^19.2.4",
    "@ionic/angular": "^8.5.2",
    "@supabase/supabase-js": "^2.112.4",
    "chart.js": "^4.4.8",
    "dexie": "^4.0.11",
    "ionicons": "^7.4.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.5",
    "@angular/cli": "^19.2.5",
    "@angular/compiler-cli": "^19.2.4",
    "@ionic/cli": "^7.2.1",
    "@playwright/test": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3"
  }
}
